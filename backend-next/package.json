{
  "name": "backend-next",
  "private": true,
  "version": "0.1.0",
  "packageManager": "pnpm@10.27.0",
  "scripts": {
    "dev:server": "pnpm --filter server dev",
    "dev:admin": "pnpm --filter admin-web dev",
    "build": "pnpm -r build",
    "migrate": "pnpm --filter server prisma:migrate",
    "migrate:legacy": "pnpm --filter server migrate:legacy"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "@prisma/client",
      "@prisma/engines",
      "esbuild",
      "prisma",
      "sharp"
    ]
  }
}
