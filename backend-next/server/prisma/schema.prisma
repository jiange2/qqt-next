// Backend-Next 新库 Schema
// 设计原则见 docs/adr/0003-nodejs-rewrite-with-legacy-facade.md：
// - 关联全部规范化（不再使用逗号分隔字段）
// - 时间戳一律 DATETIME
// - 密码一律 bcrypt
// - 迁移时保留原实体 ID（id 不设 autoincrement 由迁移显式写入，但新纪录仍需自增能力，
//   因此保留 @default(autoincrement())，迁移脚本使用显式 id 插入即可）

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

// ============ 全局设置（单行，id=1） ============

model Setting {
  id                    Int     @id @default(1)
  packageName           String  @map("package_name") @db.VarChar(255)
  onesignalAppId        String  @map("onesignal_app_id") @db.VarChar(500)
  onesignalRestKey      String  @map("onesignal_rest_key") @db.VarChar(500)
  appName               String  @map("app_name") @db.VarChar(255)
  appLogo               String  @map("app_logo") @db.VarChar(255)
  appEmail              String  @map("app_email") @db.VarChar(255)
  appVersion            String  @map("app_version") @db.VarChar(255)
  appAuthor             String  @map("app_author") @db.VarChar(255)
  appContact            String  @map("app_contact") @db.VarChar(255)
  appWebsite            String  @map("app_website") @db.VarChar(255)
  appDescription        String  @map("app_description") @db.Text
  appDevelopedBy        String  @map("app_developed_by") @db.VarChar(255)
  appPrivacyPolicy      String  @map("app_privacy_policy") @db.Text
  apiLatestLimit        Int     @map("api_latest_limit")
  apiCatOrderBy         String  @map("api_cat_order_by") @db.VarChar(255)
  apiCatPostOrderBy     String  @map("api_cat_post_order_by") @db.VarChar(255)
  publisherId           String  @map("publisher_id") @db.VarChar(500)
  interstitalAd         String  @map("interstital_ad") @db.VarChar(500)
  interstitalAdId       String  @map("interstital_ad_id") @db.VarChar(500)
  interstitalAdClick    String  @map("interstital_ad_click") @db.VarChar(500)
  bannerAd              String  @map("banner_ad") @db.VarChar(500)
  bannerAdId            String  @map("banner_ad_id") @db.VarChar(500)
  bannerAdType          String  @map("banner_ad_type") @default("admob") @db.VarChar(30)
  bannerFacebookId      String  @map("banner_facebook_id") @db.Text
  interstitalAdType     String  @map("interstital_ad_type") @default("admob") @db.VarChar(30)
  interstitalFacebookId String  @map("interstital_facebook_id") @db.Text
  nativeAd              String  @map("native_ad") @default("false") @db.VarChar(20)
  nativeAdType          String  @map("native_ad_type") @default("admob") @db.VarChar(30)
  nativeAdId            String  @map("native_ad_id") @db.Text
  nativeFacebookId      String  @map("native_facebook_id") @db.Text
  nativePosition        Int     @map("native_position") @default(5)
  appUpdateStatus       String  @map("app_update_status") @default("false") @db.VarChar(10)
  appNewVersion         Float   @map("app_new_version") @default(1)
  appUpdateDesc         String  @map("app_update_desc") @db.Text
  appRedirectUrl        String  @map("app_redirect_url") @db.Text
  cancelUpdateStatus    String  @map("cancel_update_status") @default("false") @db.VarChar(10)
  songDownload          String  @map("song_download") @default("true") @db.VarChar(255)

  @@map("settings")
}

// ============ 内容实体 ============

model Category {
  id          Int      @id @default(autoincrement()) // 旧库 cid
  name        String   @map("name") @db.VarChar(255)
  image       String   @db.VarChar(255)
  type        String   @default("music") @db.VarChar(20) // music | book（书籍阅读域 ADR 0011）：书籍分类下挂书籍而非专辑
  status      Boolean  @default(true)
  createdAt   DateTime @default(now()) @map("created_at")
  songs       Song[]
  albums      Album[]  // 分类-专辑层级（backend-next ADR 0009）：分类下放专辑而非歌曲
  books       Book[]

  @@map("categories")
}

model Artist {
  id        Int           @id @default(autoincrement()) // 旧库 id
  name      String        @map("name") @db.VarChar(255)
  image     String        @db.VarChar(255)
  createdAt DateTime      @default(now()) @map("created_at")
  songs     SongArtist[]
  albums    AlbumArtist[]

  @@map("artists")
}

// 专辑是分类与歌曲之间的层级（backend-next ADR 0009）：categoryId 可空，
// 为空即「未分类专辑」，仅存在于后台，App 端经归属链过滤不可见
model Album {
  id           Int           @id @default(autoincrement()) // 旧库 aid
  categoryId   Int?          @map("category_id")
  categorySort Int           @default(0) @map("category_sort") // 维度顺序：分类内专辑手动排序（ADR 0009）
  name         String        @map("name") @db.VarChar(255)
  image        String        @db.VarChar(255)
  status       Boolean       @default(true)
  createdAt    DateTime      @default(now()) @map("created_at")
  artists      AlbumArtist[]
  songs        Song[]
  category     Category?     @relation(fields: [categoryId], references: [id])

  @@index([categoryId])
  @@index([categoryId, categorySort])
  @@map("albums")
}

// 书籍（书籍阅读域 ADR 0011）：归属书籍分类（type=book），正文经章节下发；
// 无简介字段——App 无书籍详情页，简介没有展示位；删除约束：仍有书籍的分类阻止删除
model Book {
  id           Int      @id @default(autoincrement())
  categoryId   Int      @map("category_id")
  categorySort Int      @default(0) @map("category_sort") // 维度顺序第三维度：分类内书籍手动排序（ADR 0007 范式）
  name         String   @db.VarChar(255)
  author       String   @default("") @db.VarChar(255)
  cover        String   @default("") @db.VarChar(255) // 媒体 Key，空串=无封面（App 出占位卡）
  status       Boolean  @default(true) // 不可见即其章节对 App 不可见
  createdAt    DateTime @default(now()) @map("created_at")

  category Category @relation(fields: [categoryId], references: [id])
  chapters Chapter[]

  @@index([categoryId])
  @@index([categoryId, categorySort])
  @@map("books")
}

// 章节（书籍阅读域 ADR 0011 + 修订）：chapterSort 为章节顺序（书内展示序，sort ASC + id ASC
// 兜底，管理员可调，区别于维度顺序）；不独立上下架，可见性完全随书；删书级联删章
model Chapter {
  id          Int      @id @default(autoincrement())
  bookId      Int      @map("book_id")
  chapterSort Int      @default(0) @map("chapter_sort") // 章节顺序：书内展示序，sort ASC + id ASC 兜底（ADR 0011 修订）
  title       String   @db.VarChar(255)
  content     String   @db.MediumText // 正文全文
  createdAt   DateTime @default(now()) @map("created_at")

  book Book @relation(fields: [bookId], references: [id], onDelete: Cascade)

  @@index([bookId])
  @@index([bookId, chapterSort])
  @@map("chapters")
}

model Song {
  // categoryId 可空（backend-next ADR 0007）：未分类歌曲仅存在于后台，
  // App 端经 songStatusFilter 的关系过滤天然不可见
  id            Int        @id @default(autoincrement()) // 旧库 id
  categoryId    Int?       @map("category_id")
  albumId       Int?       @map("album_id")
  categorySort  Int        @default(0) @map("category_sort") // 维度顺序：分类内手动排序（ADR 0007）
  albumSort     Int        @default(0) @map("album_sort") // 维度顺序：专辑内手动排序
  type          String     @db.VarChar(20) // local | external（youtube 已移除）
  title         String     @db.VarChar(255)
  audioUrl      String     @map("audio_url") @db.VarChar(500) // local 存 rand 前缀文件名，external 存完整 URL
  thumbnail     String     @db.VarChar(255)
  description   String     @db.Text
  lrcText       String?    @map("lrc_text") @db.Text
  lrcUrl        String?    @map("lrc_url") @db.VarChar(255) // local 存 rand 前缀文件名
  duration      Int        @default(0) // 秒；由 App 播放就绪后写回（仓库级 ADR 0008），从未播过的歌为 0
  totalViews    Int        @default(0) @map("total_views")
  totalDownload Int        @default(0) @map("total_download")
  totalRate     Int        @default(0) @map("total_rate")
  rateAvg       Int        @default(0) @map("rate_avg")
  status        Boolean    @default(true)
  createdAt     DateTime   @default(now()) @map("created_at")
  updatedAt     DateTime   @default(now()) @updatedAt @map("updated_at")

  category  Category?     @relation(fields: [categoryId], references: [id])
  album     Album?        @relation(fields: [albumId], references: [id])
  artists   SongArtist[]
  banners   BannerSong[]
  playlists PlaylistSong[]
  trending  TrendingSong?
  ratings   Rating[]
  reports   Report[]
  favourites Favourite[]

  @@index([categoryId])
  @@index([albumId])
  @@index([categoryId, categorySort])
  @@index([albumId, albumSort])
  @@index([status, title])
  @@map("songs")
}

// 歌曲 ↔ 艺术家（替代旧 tbl_mp3.mp3_artist 逗号串）
model SongArtist {
  songId   Int    @map("song_id")
  artistId Int    @map("artist_id")
  sort     Int    @default(0)

  song   Song   @relation(fields: [songId], references: [id], onDelete: Cascade)
  artist Artist @relation(fields: [artistId], references: [id], onDelete: Cascade)

  @@id([songId, artistId])
  @@map("song_artists")
}

// 专辑 ↔ 艺术家（替代旧 tbl_album.artist_ids 逗号串）
model AlbumArtist {
  albumId  Int @map("album_id")
  artistId Int @map("artist_id")
  sort     Int @default(0)

  album  Album  @relation(fields: [albumId], references: [id], onDelete: Cascade)
  artist Artist @relation(fields: [artistId], references: [id], onDelete: Cascade)

  @@id([albumId, artistId])
  @@map("album_artists")
}

// ============ 运营位 ============

model Banner {
  id        Int          @id @default(autoincrement()) // 旧库 bid
  title     String       @db.VarChar(255)
  sortInfo  String       @map("sort_info") @db.VarChar(500)
  image     String       @db.VarChar(255)
  link      String?      @db.VarChar(500)
  status    Boolean      @default(true)
  createdAt DateTime     @default(now()) @map("created_at")
  songs     BannerSong[]

  @@map("banners")
}

// 横幅 ↔ 歌曲（替代旧 tbl_banner.banner_songs 逗号串），sort 保留挂接顺序
model BannerSong {
  bannerId Int @map("banner_id")
  songId   Int @map("song_id")
  sort     Int @default(0)

  banner Banner @relation(fields: [bannerId], references: [id], onDelete: Cascade)
  song   Song   @relation(fields: [songId], references: [id], onDelete: Cascade)

  @@id([bannerId, songId])
  @@index([bannerId, sort])
  @@map("banner_songs")
}

model Playlist {
  id        Int            @id @default(autoincrement()) // 旧库 pid
  name      String         @db.VarChar(255)
  image     String         @db.VarChar(255)
  status    Boolean        @default(true)
  createdAt DateTime       @default(now()) @map("created_at")
  songs     PlaylistSong[]

  @@map("playlists")
}

// 播放列表 ↔ 歌曲（旧库实际存 tbl_playlist.playlist_songs 逗号字段，此处规范化）
model PlaylistSong {
  playlistId Int @map("playlist_id")
  songId     Int @map("song_id")
  sort       Int @default(0)

  playlist Playlist @relation(fields: [playlistId], references: [id], onDelete: Cascade)
  song     Song     @relation(fields: [songId], references: [id], onDelete: Cascade)

  @@id([playlistId, songId])
  @@index([playlistId, sort])
  @@map("playlist_songs")
}

// 热门榜：管理员手工固定（ADR 0003 决定 4），播放量不再参与榜单
model TrendingSong {
  songId Int @map("song_id")
  sort   Int @default(0)

  song Song @relation(fields: [songId], references: [id], onDelete: Cascade)

  @@id([songId])
  @@map("trending_songs")
}

// ============ App 用户与行为 ============

model AppUser {
  id        Int      @id @default(autoincrement())
  userType  String   @map("user_type") @db.VarChar(20) // Normal | Google | Facebook
  name      String   @db.VarChar(255)
  email     String   @db.VarChar(255)
  password  String?  @db.VarChar(255) // bcrypt；社交登录用户可为空
  phone     String?  @db.VarChar(50)
  authId    String?  @map("auth_id") @db.VarChar(255)
  verified  Boolean  @default(true) // 邮件功能已移除（ADR 0003 决定 5），注册即生效
  status    Boolean  @default(true)
  createdAt DateTime @default(now()) @map("created_at")

  favourites Favourite[]
  ratings    Rating[]
  reports    Report[]
  suggestions SongSuggest[]
  activeLog  UserActiveLog?

  @@index([email])
  @@index([authId])
  @@map("app_users")
}

model Favourite {
  id        Int      @id @default(autoincrement())
  userId    Int      @map("user_id")
  postId    Int      @map("post_id") // 歌曲 ID（type 目前仅 song）
  type      String   @default("song") @db.VarChar(20)
  createdAt DateTime @default(now()) @map("created_at")

  user AppUser @relation(fields: [userId], references: [id], onDelete: Cascade)
  song Song    @relation(fields: [postId], references: [id], onDelete: Cascade)

  @@unique([userId, postId, type])
  @@map("favourites")
}

// 旧库 tbl_rating 的 ip 字段实际存 user_id，此处正名为 user_id
model Rating {
  id        Int      @id @default(autoincrement())
  postId    Int      @map("post_id")
  userId    Int      @map("user_id")
  rate      Int
  createdAt DateTime @default(now()) @map("created_at")

  song Song    @relation(fields: [postId], references: [id], onDelete: Cascade)
  user AppUser @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([postId, userId])
  @@map("ratings")
}

model Report {
  id        Int      @id @default(autoincrement())
  userId    Int      @map("user_id")
  songId    Int      @map("song_id")
  report    String   @db.Text
  createdAt DateTime @default(now()) @map("created_at")

  user AppUser @relation(fields: [userId], references: [id], onDelete: Cascade)
  song Song    @relation(fields: [songId], references: [id], onDelete: Cascade)

  @@map("reports")
}

model SongSuggest {
  id        Int      @id @default(autoincrement())
  userId    Int      @map("user_id")
  songTitle String   @map("song_title") @db.VarChar(255)
  songImage String?  @map("song_image") @db.VarChar(255)
  message   String   @db.Text
  createdAt DateTime @default(now()) @map("created_at")

  user AppUser @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("song_suggestions")
}

// 用户活跃日志（运行时写入；旧存量不迁移）
model UserActiveLog {
  userId       Int      @id @map("user_id")
  lastActiveAt DateTime @default(now()) @map("last_active_at")

  user AppUser @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("user_active_logs")
}

// ============ 管理员 ============

model AdminUser {
  id        Int      @id @default(autoincrement())
  username  String   @unique @db.VarChar(100)
  password  String   @db.VarChar(255) // bcrypt
  email     String?  @db.VarChar(255)
  image     String?  @db.VarChar(255)
  createdAt DateTime @default(now()) @map("created_at")

  @@map("admin_users")
}

// ============ 访问统计（仓库级 ADR 0008）============

// 访问事实：append-only 流水，不去重不聚合，无字节维度（条数口径）。
// songId 为裸列不设外键：事实指向的歌曲被删除后事实保留（明细展示「已删除歌曲」），
// 若建 FK 会阻塞歌曲删除，与口径冲突。
model AccessFact {
  id               Int      @id @default(autoincrement())
  songId           Int      @map("song_id")
  deviceId         String   @map("device_id") @db.VarChar(50) // 设备 ID（见 android 上下文）
  cacheHit         Boolean  @default(false) @map("cache_hit")
  allocatedStorage BigInt?  @map("allocated_storage") // 上报时刻缓存预算快照（字节）
  usedStorage      BigInt?  @map("used_storage") // 上报时刻被动缓存实际占用（字节）
  appVersion       String?  @map("app_version") @db.VarChar(32) // 上报时刻 App 版本（versionName；老事实/未上报客户端为 NULL）
  ipAddress        String   @map("ip_address") @db.VarChar(45)
  userAgent        String?  @map("user_agent") @db.Text
  accessedAt       DateTime @default(now()) @map("accessed_at")

  @@index([deviceId, accessedAt])
  @@index([accessedAt])
  @@map("access_facts")
}

// 在线采样：进程内每 5 分钟一行的时序化存证，sampledAt 为幂等键
// （重启漏采不补，折线跨过丢点区间）
model OnlineSample {
  sampledAt   DateTime @id @map("sampled_at")
  totalOnline Int      @map("total_online")

  @@map("online_samples")
}
