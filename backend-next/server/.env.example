# 新库连接（与旧库 qqt 隔离，建议新库名 qqt_next）
DATABASE_URL="mysql://root:password@localhost:3306/qqt_next"

# 旧库连接（仅迁移脚本使用）
LEGACY_DB_URL="mysql://root:password@localhost:3306/qqt"

# 服务端口
PORT=8000

# 管理端 JWT 密钥（务必修改）
JWT_SECRET="change-me-to-a-long-random-string"

# 阿里云 OSS（ADR 0004：媒体对象存储，DB 只存 key，URL 运行时拼接）
OSS_REGION="oss-cn-shanghai"
OSS_BUCKET="qqt7"
OSS_ACCESS_KEY_ID=""
OSS_ACCESS_KEY_SECRET=""
# 上传走内网 endpoint（同 region ECS 免流量费，SDK internal 参数自动切 -internal 域名）
OSS_INTERNAL="false"
# 对外媒体 URL 基地址（公网 endpoint / 自定义域名 / CDN，换 CDN 只改这里）
OSS_PUBLIC_BASE="https://qqt7.oss-cn-shanghai.aliyuncs.com/"

# 下载二维码对外基地址（仓库级 ADR 0013：后台生成二维码时拼进令牌链接；缺省服务器 IP，明文 80 直出）
DOWNLOAD_PUBLIC_BASE="http://101.132.159.145"
