# ====== 旧 PHP 栈（docker-compose.yml，开发/旧服务器用）======
# 数据库配置
DB_PORT=3306
DB_NAME=qqt
DB_PASSWORD=lq520977WC

# ====== backend-next 生产部署（docker-compose.next.yml，新服务器用）======
# 注意：与旧栈共用 DB_PASSWORD 变量名，两台服务器各配各的

# 镜像仓库（命名空间 qqt7 / 仓库 qqt_repo，已硬编码在 compose）；
# 同 region ECS 拉镜像走内网免流量费时设：ACR_HOST=crpi-oyq5ia6dv9vty8p3-vpc.cn-shanghai.personal.cr.aliyuncs.com
#ACR_HOST=

# 新库（宿主机宝塔 MySQL：建库 qqt_next，账号 qqt_next@172.% 只授本库；
# host 用 172.% 而非 172.17.%：compose 网络是动态网段，实测出现过 172.19.0.x；
# 3306 不对公网开放，容器经 host.docker.internal 访问）
# DB_PASSWORD 同上

# JWT 密钥（强随机：openssl rand -hex 32）
JWT_SECRET=

# 阿里云 OSS（backend-next 媒体存储，ADR 0004；bucket qqt7 @ 上海）
OSS_REGION=oss-cn-shanghai
OSS_BUCKET=qqt7
OSS_ACCESS_KEY_ID=
OSS_ACCESS_KEY_SECRET=
# 服务器与 bucket 同 region：上传走内网免流量费（SDK internal 参数）
OSS_INTERNAL=true
# 对外媒体 URL 基地址（公网 endpoint / 自定义域名 / CDN，换 CDN 只改这里）
OSS_PUBLIC_BASE=https://qqt7.oss-cn-shanghai.aliyuncs.com/
# 媒体 key 原名加密密钥（ADR 0008，任意字符串，必填：缺失则启动失败）
OSS_NAME_SECRET=
# 歌词文件内容加密口令（docs/adr/0010，任意字符串，必填：缺失则启动失败；须与 App 端 AppConfig.LRC_CONTENT_SECRET 一致）
LRC_CONTENT_SECRET=518b465562a5ec61b6d750fa68533bc1
